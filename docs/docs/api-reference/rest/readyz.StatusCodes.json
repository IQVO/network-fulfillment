{"responses":{"200":{"description":"Ready to receive traffic.","content":{"application/json":{"schema":{"type":"object","required":["status"],"properties":{"status":{"type":"string","example":"ready"}}}}}},"503":{"description":"Not ready. Either graceful shutdown is in progress (`application/json`, `{\"status\":\"not_ready\"}`), or Postgres or Kafka is unreachable (`application/problem+json`, type `dependency-unavailable`, `detail` naming the failing dependency, e.g. `not ready: postgres`). A `readinessProbe` observing this should stop routing new requests to this pod; already-established connections are unaffected.\n","content":{"application/json":{"schema":{"type":"object","required":["status"],"properties":{"status":{"type":"string","example":"not_ready"}}}},"application/problem+json":{"schema":{"type":"object","description":"RFC 7807 problem details.","required":["type","title","status"],"properties":{"type":{"type":"string","format":"uri","example":"https://errors.network-fulfillment.warehouse-systems.dev/network-order-not-found"},"title":{"type":"string","example":"Network order not found"},"status":{"type":"integer","example":404},"detail":{"type":"string","example":"network order not found"},"instance":{"type":"string","example":"/network-orders/po-4711"}},"title":"Problem"},"example":{"type":"https://errors.network-fulfillment.warehouse-systems.dev/dependency-unavailable","title":"A runtime dependency is unavailable","status":503,"detail":"not ready: kafka","instance":"/readyz"}}}}}}